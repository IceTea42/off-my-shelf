# Normalise line endings: LF in the repo and in every checkout (Windows included),
# so ruff format checks, Docker builds and CI behave the same on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.heic binary
*.mp4  binary
*.mov  binary
*.webm binary
*.wav  binary
*.mp3  binary
*.m4a  binary
*.zip  binary
*.pdf  binary
