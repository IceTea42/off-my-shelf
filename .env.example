# Copy to .env and fill in the keys you have. .env is git-ignored: never commit it.
# Comments stay on their own lines so every dotenv parser reads the values cleanly.

# --- Meta Model API: Muse Spark, Muse Image, Muse Voice Transcribe, SAM 3.1 ---
META_API_KEY=

# --- Open-weight path: Muse Spark Open on a partner's OpenAI-compatible endpoint ---
# true = item analysis runs on Muse Spark Open instead of Muse Spark (SAM, images stay on Meta)
OMS_USE_SPARK_OPEN=false
OMS_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# Baseten: https://inference.baseten.co/v1 · Fireworks: https://api.fireworks.ai/inference/v1
OMS_SPARK_OPEN_BASE_URL=https://inference.baseten.co/v1
# The key for that endpoint (BASETEN_API_KEY or FIREWORKS_API_KEY also work)
OMS_SPARK_OPEN_API_KEY=

# --- Listings: en (default), fr or tr ---
OMS_DEFAULT_LANGUAGE=en

# --- Local API-result cache, keyed by input hash (lets demos replay offline at no cost) ---
OMS_CACHE_DIR=.cache

# --- Public deployments: refuse new live work once this much USD (list price) is spent ---
# OMS_BUDGET_USD=5

# --- Debug only: keep every voice note (upload, API WAV, outcome) in <cache>/voice ---
OMS_DEBUG_VOICE=false

# --- Too little detail to list: smaller photos/frames and items are skipped with a warning ---
OMS_MIN_STILL_SIDE_PX=320
OMS_MIN_ITEM_SIDE_PX=40
OMS_MIN_ITEM_PIXELS=2500
