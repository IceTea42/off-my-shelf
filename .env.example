# Copy to .env and fill in the keys you have. .env is git-ignored: never commit it.
# Comments stay on their own lines so every dotenv parser reads the values cleanly.

# --- Meta Model API: Muse Spark, Muse Image, Muse Voice Transcribe, Muse Wonder, SAM 3.1 ---
META_API_KEY=

# --- Open-weight path: Muse Spark Open through a partner (fill only the one you use) ---
# Provider: baseten | modal | fireworks
OMS_OPEN_WEIGHTS_PROVIDER=baseten
OMS_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
OMS_USE_SPARK_OPEN=false
BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FIREWORKS_API_KEY=

# --- Local API-result cache, keyed by input hash (lets demos replay offline at no cost) ---
OMS_CACHE_DIR=.cache
